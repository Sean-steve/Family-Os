{
  "openapi": "3.1.0",
  "info": {
    "title": "Family OS Foundation API",
    "version": "0.2.0-b1",
    "description": "Authenticated Family OS B1 adult household registry and owner-governed memberships; private profiles, minors, consent and cross-OS authority remain unavailable. B1 SPA uses OIDC code+PKCE and sends access token only in Authorization header."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001",
      "description": "Local only; configure TLS for deployment."
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Non-sensitive checks"
    },
    {
      "name": "identity",
      "description": "Verified OIDC principal"
    },
    {
      "name": "families",
      "description": "Tenant bootstrap and own-family lookup"
    },
    {
      "name": "households",
      "description": "Family-scoped non-sensitive household labels, allowed for OWNER/CO_PARENT write and ADULT read"
    },
    {
      "name": "membership",
      "description": "Owner-only verified adult/guest roster and restricted role/revocation"
    },
    {
      "name": "invitations",
      "description": "Owner-issued one-time 48-hour codes bound to pre-registered OIDC actor IDs"
    }
  ],
  "security": [],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness (not readiness)",
        "operationId": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "API process alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "family-os-api"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "PostgreSQL connectivity only",
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "DB reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not_ready"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Return verified issuer-qualified identity, not person profile",
        "operationId": "getCurrentIdentity",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CurrentPrincipal"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/families": {
      "get": {
        "summary": "Families visible to current active membership only",
        "operationId": "listMyFamilies",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized family list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "count",
                        "hasMore"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "$ref": "#/components/schemas/Family"
                          }
                        },
                        "count": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create one owned family, membership, audit and outbox in one transaction",
        "operationId": "createFamily",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FamilyInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created family",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Family"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/families/{familyId}": {
      "get": {
        "summary": "Retrieve family only with an active membership",
        "operationId": "getMyFamily",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "familyId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized family",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Family"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/families/{familyId}/households": {
      "get": {
        "tags": [
          "households"
        ],
        "operationId": "listHouseholds",
        "summary": "List active non-sensitive household labels (adult roles only)",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Visible household list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "hasMore"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Household"
                          }
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      },
      "post": {
        "tags": [
          "households"
        ],
        "operationId": "createHousehold",
        "summary": "Create household label (OWNER or CO_PARENT)",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HouseholdInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Household created and audit/outbox committed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Household"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      }
    },
    "/api/v1/families/{familyId}/households/{householdId}": {
      "patch": {
        "tags": [
          "households"
        ],
        "operationId": "updateHousehold",
        "summary": "Update household label/kind (OWNER or CO_PARENT)",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "PRIMARY_HOME",
                      "SECONDARY_HOME",
                      "SHARED_HOME",
                      "OTHER"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Household updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Household"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      },
      "delete": {
        "tags": [
          "households"
        ],
        "operationId": "archiveHousehold",
        "summary": "Soft archive household (OWNER or CO_PARENT)",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Archived"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/families/{familyId}/memberships": {
      "get": {
        "tags": [
          "membership"
        ],
        "operationId": "listAdultMemberships",
        "summary": "Owner-only roster of verified adult and guest OIDC actors; no profiles",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Visible membership roster",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "hasMore"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Membership"
                          }
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      }
    },
    "/api/v1/families/{familyId}/memberships/{userId}": {
      "patch": {
        "tags": [
          "membership"
        ],
        "operationId": "changeLimitedMemberRole",
        "summary": "Owner can switch only ADULT/GUEST roles, never OWNER or minors",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "enum": [
                      "ADULT",
                      "GUEST"
                    ],
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Limited role updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Membership"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      },
      "delete": {
        "tags": [
          "membership"
        ],
        "operationId": "revokeLimitedMember",
        "summary": "Owner revokes ADULT/GUEST membership; owner cannot be revoked or demoted",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Membership revoked"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found or protected role"
          }
        }
      }
    },
    "/api/v1/families/{familyId}/invitations": {
      "post": {
        "tags": [
          "invitations"
        ],
        "operationId": "issueInvitation",
        "summary": "Owner creates a one-time invitation bound to a verified OIDC actor ID",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "targetUserId",
                  "role"
                ],
                "additionalProperties": false,
                "properties": {
                  "targetUserId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADULT",
                      "GUEST"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation created; secret returned once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/InvitationCreated"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      }
    },
    "/api/v1/invitations/{invitationId}/accept": {
      "post": {
        "tags": [
          "invitations"
        ],
        "operationId": "acceptBoundInvitation",
        "summary": "Signed target subject redeems own unexpired one-time invite",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation accepted and membership created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "familyId",
                        "role"
                      ],
                      "properties": {
                        "familyId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role": {
                          "enum": [
                            "ADULT",
                            "GUEST"
                          ],
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Signed access token missing or invalid"
          },
          "403": {
            "description": "Verified role forbidden"
          },
          "404": {
            "description": "Family or record not visible"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256 OIDC access token with pinned issuer, audience and JWKS."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHORIZED",
                  "VALIDATION_ERROR",
                  "NOT_FOUND",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Family": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CurrentPrincipal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "familyCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authority": {
            "type": "string",
            "const": "OIDC"
          },
          "familyCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FamilyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        }
      },
      "Household": {
        "type": "object",
        "required": [
          "id",
          "familyId",
          "name",
          "kind",
          "createdAt",
          "updatedAt",
          "archivedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "familyId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
