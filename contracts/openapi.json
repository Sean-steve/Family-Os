{
  "openapi": "3.1.0",
  "info": {
    "title": "Family OS Foundation API",
    "version": "0.1.0-b0",
    "description": "Phase B0 foundation only. No live private family modules, AI, media or child-profile endpoints. All bearer tokens must be audience-bound signed OIDC access tokens, never frontend roles."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001",
      "description": "Local only; configure TLS for deployment."
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Non-sensitive checks"
    },
    {
      "name": "identity",
      "description": "Verified OIDC principal"
    },
    {
      "name": "families",
      "description": "Tenant bootstrap and own-family lookup"
    }
  ],
  "security": [],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness (not readiness)",
        "operationId": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "API process alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "family-os-api"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "PostgreSQL connectivity only",
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "DB reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not_ready"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Return verified issuer-qualified identity, not person profile",
        "operationId": "getCurrentIdentity",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CurrentPrincipal"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/families": {
      "get": {
        "summary": "Families visible to current active membership only",
        "operationId": "listMyFamilies",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized family list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "count",
                        "hasMore"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "$ref": "#/components/schemas/Family"
                          }
                        },
                        "count": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create one owned family, membership, audit and outbox in one transaction",
        "operationId": "createFamily",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FamilyInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created family",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Family"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/families/{familyId}": {
      "get": {
        "summary": "Retrieve family only with an active membership",
        "operationId": "getMyFamily",
        "security": [
          {
            "OidcBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "familyId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized family",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Family"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Safe error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256 OIDC access token with pinned issuer, audience and JWKS."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHORIZED",
                  "VALIDATION_ERROR",
                  "NOT_FOUND",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Family": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CurrentPrincipal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "familyCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authority": {
            "type": "string",
            "const": "OIDC"
          },
          "familyCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FamilyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        }
      }
    }
  }
}
