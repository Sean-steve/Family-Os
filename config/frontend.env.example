# Optional Vite frontend BUILD-TIME variables — copy into root .env.local.
# These are public OIDC SPA metadata, NEVER secrets or access tokens.
# Leave them unset to keep Live Registry deliberately disabled.
VITE_FAMILY_API_URL=https://api.family.example
VITE_FAMILY_OIDC_AUTHORITY=https://identity.family.example/realms/family
VITE_FAMILY_OIDC_CLIENT_ID=family-os-spa
VITE_FAMILY_OIDC_SCOPE=openid profile
#
# Exact OIDC redirect URI for GitHub Pages:
#   https://sean-steve.github.io/Family-Os/
# The SPA performs Authorization Code + PKCE.
# The API provider must issue an access token with aud=family-os-api.
# Registration and trusted origins must match the backend's allowed CORS origins.
# Never put an OIDC client secret or DATABASE_URL in VITE_* variables.
