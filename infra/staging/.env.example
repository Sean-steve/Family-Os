# STAGING TEMPLATE ONLY. Never commit this file once values are populated.
# Copy to /srv/family-os/.env.staging; protect permissions (chmod 600).
# These are examples, not functioning credentials or provisioned domains.
FAMILY_API_DOMAIN=api.family.example.invalid
FAMILY_IDENTITY_DOMAIN=identity.family.example.invalid
FAMILY_WEB_ORIGIN=https://sean-steve.github.io
FAMILY_ACME_EMAIL=operator@example.invalid
FAMILY_ADMIN_ALLOW_CIDR=127.0.0.1/32
# Two independently provisioned managed PostgreSQL databases with TLS.
# Runtime role must be family_runtime; migrations require restricted admin.
FAMILY_DATABASE_URL=postgresql://family_runtime:REPLACE_RUNTIME_SECRET@db.family.example.invalid:5432/family_os?sslmode=verify-full
FAMILY_DATABASE_ADMIN_URL=postgresql://family_admin:REPLACE_ADMIN_SECRET@db.family.example.invalid:5432/family_os?sslmode=verify-full
# Keycloak requires own Postgres DB; configure managed CA/trust as needed.
FAMILY_IDENTITY_JDBC_URL=jdbc:postgresql://db.identity.example.invalid:5432/family_identity?sslmode=require
FAMILY_IDENTITY_DB_USER=keycloak_runtime
FAMILY_IDENTITY_DB_PASSWORD=REPLACE_IDENTITY_DB_SECRET
FAMILY_IDENTITY_ADMIN_USER=family_admin
FAMILY_IDENTITY_ADMIN_PASSWORD=REPLACE_ADMIN_BOOTSTRAP_SECRET
