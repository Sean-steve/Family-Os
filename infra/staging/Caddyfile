{
  email {$ACME_EMAIL}
}

{$FAMILY_API_DOMAIN} {
  encode zstd gzip
  @readiness path /health/ready
  respond @readiness 404
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
  reverse_proxy family-api:3001
}

{$FAMILY_IDENTITY_DOMAIN} {
  encode zstd gzip
  @admin path /admin /admin/*
  handle @admin {
    @denied not remote_ip {$FAMILY_ADMIN_ALLOW_CIDR}
    respond @denied 403
    reverse_proxy family-identity:8080
  }
  handle {
    reverse_proxy family-identity:8080
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
