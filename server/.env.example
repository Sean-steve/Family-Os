# Copy to a private .env.b0 and replace all placeholders; NEVER commit populated credentials.
# URLs must point to the same database, with different principals.
DATABASE_ADMIN_URL=postgresql://family_admin:REPLACE_ADMIN_PASSWORD@127.0.0.1:5432/family_os
DATABASE_URL=postgresql://family_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:5432/family_os
OIDC_ISSUER=https://identity.example.com/realms/family
OIDC_AUDIENCE=family-os-api
OIDC_JWKS_URI=https://identity.example.com/realms/family/protocol/openid-connect/certs
APP_ALLOWED_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development
# Local Postgres via compose (values must match DATABASE_URL above).
PG_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
PG_RUNTIME_PASSWORD=REPLACE_RUNTIME_PASSWORD
PG_PORT=5432
